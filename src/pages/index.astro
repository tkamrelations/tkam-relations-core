---
const title = "TKAM RELATIONS";
---
<html lang="fi">
  <head><meta charset="utf-8" /><title>{title}</title></head>
  <body style="font-family: Georgia, serif; max-width: 700px; margin: 40px auto; padding: 20px; background: #f4f2ec; color: #111;">
    <header style="border-bottom: 2px solid #111; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
      <h1 style="margin: 0; font-size: 2rem; letter-spacing: 1px;">{title}</h1>
    </header>
    <main style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
      <section style="background: #fff; padding: 20px; border: 1px solid #111;">
        <h3 style="margin-top: 0; font-size: 1rem; text-transform: uppercase;">[ Pääkirjoitus ]</h3>
        <p>[ Pääkirjoituksen tila ]</p>
      </section>
      <aside style="background: #eae6df; padding: 20px; border: 1px solid #111;">
        <h3 style="margin-top: 0; font-size: 1rem; text-transform: uppercase;">[ Tuotesijoittelu ]</h3>
        <p>[ Mainospaikka ]</p>
      </aside>
    </main>
  </body>
</html>